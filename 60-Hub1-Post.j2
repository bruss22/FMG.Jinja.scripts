config system interface
    edit {{UL1_port}}
        set allowaccess speed-test fgfm ping
        set outbandwidth {{UL1_outbw}}
        set inbandwidth {{UL1_inbw}}
        set estimated-upstream-bandwidth {{UL1_outbw}}
        set estimated-downstream-bandwidth {{UL1_inbw}}
        set monitor-bandwidth enable
    next
    edit {{UL2_port}}
        set allowaccess speed-test fgfm ping
        set outbandwidth {{UL2_outbw}}
        set inbandwidth {{UL2_inbw}}
        set estimated-upstream-bandwidth {{UL2_outbw}}
        set estimated-downstream-bandwidth {{UL2_inbw}}
        set monitor-bandwidth enable
    next
end
